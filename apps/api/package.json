{
  "name": "@drlaudo/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.22.2" },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "prebuild": "npm run build -w @drlaudo/contract",
    "build": "prisma generate && tsc --noEmit",
    "pretypecheck": "npm run build -w @drlaudo/contract",
    "typecheck": "prisma generate && tsc --noEmit",
    "pretest": "npm run build -w @drlaudo/contract && npm run db:generate",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@drlaudo/contract": "0.0.0",
    "@fastify/jwt": "10.2.7",
    "@fastify/rate-limit": "11.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcryptjs": "3.0.3",
    "dotenv": "17.2.3",
    "fastify": "5.12.8",
    "pg": "8.23.1",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "pino-pretty": "13.2.0",
    "prisma": "7.10.1",
    "vitest": "5.1.0"
  }
}
