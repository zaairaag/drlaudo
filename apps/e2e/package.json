  "dependencies": {
    "@drlaudo/contract": "0.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@types/node": "22.20.5",
    "bcryptjs": "3.0.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.6"
  }
}
