# Exemplo de configuração — copie para .env e ajuste. Nenhum segredo real aqui.

# Banco demonstrativo (PostgreSQL 16). O override docker-compose.hybrid.yml
# publica somente em loopback:5433; a demo completa não publica o banco.
DATABASE_URL=postgresql://drlaudo:drlaudo@127.0.0.1:5433/drlaudo?schema=public
DRLAUDO_DB_PORT=5433
# QA é outro projeto/servidor, descartável e exclusivo (override qa-host).
# Ajuste ambas as portas se já estiverem ocupadas; nunca use a base demo.
DATABASE_URL_TEST=postgresql://drlaudo:drlaudo@127.0.0.1:55433/drlaudo_test?schema=public
DRLAUDO_QA_DB_PORT=55433
DRLAUDO_QA_HTTP_PORT=18080

# Mínimo de 32 caracteres. Gere um valor próprio; nunca versione o real.
JWT_SECRET=change-me-with-at-least-32-random-characters
HOST=127.0.0.1
PORT=3333
# Sem proxy no npm run dev. Compose usa 1 hop interno, nunca API pública.
TRUST_PROXY_HOPS=0
LOGIN_RATE_LIMIT_MAX=10
NODE_ENV=development

# Ative apenas em desenvolvimento para servir a UI sobre MSW:
VITE_API_MOCKING=false
